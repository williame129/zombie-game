<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🏆 屍境重構 - 全球英雄榜</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #0d0f18;
            color: #fff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        .board-card {
            background: rgba(20, 25, 40, 0.95);
            border: 2px solid #00ffff;
            box-shadow: 0 0 25px rgba(0, 255, 255, 0.3);
            border-radius: 15px;
            width: 100%;
            max-width: 550px;
            padding: 25px;
            text-align: center;
        }

        h1 {
            margin-top: 0;
            color: #00ffff;
            text-shadow: 0 0 10px rgba(0, 255, 255, 0.5);
            font-size: 26px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            padding: 12px 8px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        th {
            background: rgba(0, 255, 255, 0.15);
            color: #00ffff;
            font-size: 15px;
        }

        tr:nth-child(1) .rank { color: #ffd700; font-weight: bold; font-size: 18px; } /* 金 */
        tr:nth-child(2) .rank { color: #c0c0c0; font-weight: bold; font-size: 17px; } /* 銀 */
        tr:nth-child(3) .rank { color: #cd7f32; font-weight: bold; font-size: 16px; } /* 銅 */

        .player-name { font-weight: bold; color: #ffffff; }
        .stat-highlight { color: #ff5555; font-weight: bold; }

        .btn-refresh {
            background: #ff4444;
            color: white;
            border: none;
            padding: 10px 20px;
            margin-top: 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: 0.2s;
        }

        .btn-refresh:hover { background: #ff6666; }
    </style>
    <!-- 引入 Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.1/firebase-database-compat.js"></script>
</head>
<body>

    <div class="board-card">
        <h1>🏆 生存者排行榜</h1>
        <div id="loading" style="color: #aaa; margin: 20px 0;">⏳ 正在載入全球排行榜...</div>
        
        <table id="leaderboard-table" style="display: none;">
            <thead>
                <tr>
                    <th>排名</th>
                    <th>玩家</th>
                    <th>最高波次</th>
                    <th>擊殺數</th>
                </tr>
            </thead>
            <tbody id="leaderboard-body">
                <!-- 資料會自動填入此處 -->
            </tbody>
        </table>

        <button class="btn-refresh" onclick="loadLeaderboard()">🔄 重新整理</button>
    </div>

<script>
    // https://zombie-game-43de9-default-rtdb.asia-southeast1.firebasedatabase.app/
    const firebaseConfig = {
        databaseURL: "https://YOUR_DATABASE_URL.firebaseio.com/" 
    };

    // 初始化 Firebase
    firebase.initializeApp(firebaseConfig);
    const database = firebase.database();

    // 載入並顯示排行榜資料
    function loadLeaderboard() {
        document.getElementById('loading').style.display = 'block';
        document.getElementById('leaderboard-table').style.display = 'none';

        // 讀取 top_scores，依據 wave (波次) 排序，並取前 10 名
        const scoresRef = database.ref('top_scores').orderByChild('wave').limitToLast(10);
        
        scoresRef.once('value', (snapshot) => {
            const tbody = document.getElementById('leaderboard-body');
            tbody.innerHTML = '';

            let dataList = [];
            snapshot.forEach((child) => {
                dataList.push(child.val());
            });

            // Firebase 預設升冪，需要反轉為降冪 (波次高者在前)
            dataList.reverse();

            if (dataList.length === 0) {
                document.getElementById('loading').innerText = "尚無玩家上榜，快去挑戰吧！";
                return;
            }

            dataList.forEach((data, index) => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="rank">#${index + 1}</td>
                    <td class="player-name">${escapeHtml(data.name || '無名勇士')}</td>
                    <td class="stat-highlight">第 ${data.wave} 波</td>
                    <td>${data.kills} 隻</td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('loading').style.display = 'none';
            document.getElementById('leaderboard-table').style.display = 'table';
        });
    }

    // 防範 HTML 注入的小工具
    function escapeHtml(text) {
        return text.replace(/[&<>"']/g, function(m) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]; });
    }

    // 網頁開啟時自動載入資料
    loadLeaderboard();
</script>

</body>
</html>
